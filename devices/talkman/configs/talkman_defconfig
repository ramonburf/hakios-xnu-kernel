# HakiOS defconfig for the Microsoft Lumia 950 (talkman, MSM8992): the common kernel with none of another phone's drivers.
# Every driver of the common repository is written for redwood's (or QEMU's) addresses, pins and rails; on the 950 they
# are other chips or nothing at all, and the first boot hung right after the framebuffer with all of them built in.
# Kept: the storage service through the loader (CONFIG_HAKIOS_UFS, ufs=2), which touches no controller of its own.
# Build with HAKIOS_GIC=v2 HAKIOS_CPU=v8.0 (GICv2 driver, no PAN): make talkman_defconfig && make kernel.
#include common_defconfig
#include open.config
CONFIG_DEVICE="talkman"
CONFIG_UFS=2
CONFIG_TOUCHSCREEN=y
CONFIG_HAKIOS_SYNAPTICS=y
CONFIG_HAKIOS_ADRENO4=y
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_PMI8994=y
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
